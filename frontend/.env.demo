# Demo build — fake in-browser backend, no server, no real auth.
# Loaded by: npm run build:demo  (vite --mode demo)
# Firebase values are dummies: demo mode never calls real Firebase auth.

VITE_DEMO_MODE=true
VITE_FIREBASE_USE_EMULATOR=false
VITE_API_URL=https://demo-no-backend.invalid
VITE_FIREBASE_PROJECT_ID=snappy-mapper-498223-b2
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=snappy-mapper-498223-b2.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app
