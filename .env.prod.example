# ── Backend: Production (GCP) ────────────────────────────────────────────────
# Copy to .env.prod, fill in real values, NEVER commit .env.prod

RAGAAS_ENV=production
FIREBASE_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# CORS: restrict to Firebase Hosting domain
CORS_ORIGIN_REGEX=https://(your-project\.web\.app|your-custom-domain\.com)

# GitHub / Firebase deploy tokens (also in .env for MCP servers)
# GITHUB_PERSONAL_ACCESS_TOKEN=
# FIREBASE_TOKEN=
