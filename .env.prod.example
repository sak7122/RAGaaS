# ── Backend: Production (GCP) ────────────────────────────────────────────────
# Copy to .env.prod, fill in real values, NEVER commit .env.prod

RAGAAS_ENV=production
FIREBASE_PROJECT_ID=ragaas-af876
GCP_PROJECT_ID=ragaas-af876
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# GCS bucket for PDF storage (create with: gcloud storage buckets create gs://BUCKET --location=us-central1)
GCS_BUCKET=genaiacademy-ragaas-pdfs

# ── RAG (Phase 1) ────────────────────────────────────────────────────────────
# Embeddings + generation run on Vertex AI / Gemini via the runtime SA (keyless ADC).
RAG_ENGINE_LABEL=Hybrid Vector Search
EMBED_MODEL=text-embedding-005
GEMINI_MODEL=gemini-2.5-flash-lite
VERTEX_LOCATION=us-central1

# CORS: restrict to Firebase Hosting domain
CORS_ORIGIN_REGEX=https://(your-project\.web\.app|your-custom-domain\.com)

# ── Invite emails (optional) ─────────────────────────────────────────────────
# Public frontend URL used to build invite links
# (defaults to https://<FIREBASE_PROJECT_ID>.web.app if unset).
APP_BASE_URL=https://your-project.web.app
# SMTP for sending member-invite emails. Gmail path: create a Google account
# App Password (Account -> Security -> 2-Step Verification -> App passwords)
# and put it in SMTP_PASSWORD. Leave USER+PASSWORD empty to disable sending
# (the API then returns the invite link for manual sharing).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=                 # 16-char app password — set via secret, NEVER commit
SMTP_FROM=RAGaaS <you@gmail.com>

# GitHub / Firebase deploy tokens (also in .env for MCP servers)
# GITHUB_PERSONAL_ACCESS_TOKEN=
# FIREBASE_TOKEN=
    