# ── Backend: Development (local emulators) ───────────────────────────────────
RAGAAS_ENV=development
FIREBASE_PROJECT_ID=ragaas-local
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# In-memory stores — skips Firestore emulator, instant responses in dev
RAGAAS_USE_MEMORY_STORE=1
